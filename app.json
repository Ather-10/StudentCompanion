{
  "expo": {
    "name": "Student Companion",
    "slug": "StudentCompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ather.studentcompanion",
      "adaptiveIcon": {
        "backgroundColor": "#5B4BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5B4BFF",
          "sounds": [
            "./assets/sounds/alarm_classic.wav",
            "./assets/sounds/alarm_digital.wav",
            "./assets/sounds/alarm_chime.wav",
            "./assets/sounds/alarm_rise.wav",
            "./assets/sounds/alarm_soft.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Student Companion to access your photos for your profile picture.",
          "cameraPermission": "Allow Student Companion to use the camera for your profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16132E"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9f4897dc-5b50-4136-90ec-1da15fb1e097"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9f4897dc-5b50-4136-90ec-1da15fb1e097"
    }
  }
}
