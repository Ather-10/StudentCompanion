{
  "expo": {
    "name": "StudentCompanion",
    "slug": "StudentCompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
       "package": "com.ather.studentcompanion",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
        "expo-notifications",
        ["expo-image-picker", {
          "photosPermission": "Allow Student Companion to access your photos for your profile picture.",
          "cameraPermission": "Allow Student Companion to use the camera for your profile picture."
        }]
      ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9f4897dc-5b50-4136-90ec-1da15fb1e097"
      }
    }
  }
}
